[submodule "implementations/ntpd-rs/ntpd-rs"]
	path = implementations/ntpd-rs/ntpd-rs
	url = https://github.com/pendulum-project/ntpd-rs.git
	branch = main
[submodule "implementations/chrony-ntp5/chrony-ntp5"]
	path = implementations/chrony-ntp5/chrony-ntp5
	url = https://github.com/mlichvar/chrony-ntp5.git
	branch = ntpv5
[submodule "implementations/ntp5-exp/ntp5-exp"]
	path = implementations/ntp5-exp/ntp5-exp
	url = https://github.com/mlichvar/ntp5-exp.git
	branch = main
[submodule "implementations/ntp-nts-tool/ntp-nts-tool"]
	path = implementations/ntp-nts-tool/ntp-nts-tool
	url = https://github.com/SerbanOrza/ntp-nts-tool.git
	branch = main
[submodule "implementations/ntp-go/ntp-go"]
	path = implementations/ntp-go/ntp-go
	url = https://github.com/beevik/ntp.git
	branch = ntp5
